# Copy to .env and adjust for your environment. Never commit real secrets.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# In development, password-reset emails are printed to the runserver console.
# Production SMTP settings:
DJANGO_DEFAULT_FROM_EMAIL=sgams@unilus.ac.zm
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=True
# Production example:
# DATABASE_URL=postgres://user:password@localhost:5432/unilus_sgams
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=your-domain.example
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# Set DJANGO_TRUST_PROXY_SSL=True only behind a trusted proxy that overwrites X-Forwarded-Proto.
